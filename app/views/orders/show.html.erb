<% content_for :title, "Order #{@order.number} — MegaShop" %>

<div class="page-header text-center" style="background-image: url('/molla/assets/images/page-header-bg.jpg')">
  <div class="container">
    <h1 class="page-title">Order Confirmed<span>Thank you for your purchase</span></h1>
  </div>
</div>

<div class="page-content">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="text-center mb-5">
          <i class="icon-check-circle" style="font-size:6rem;color:#a8c500;"></i>
          <h2 class="mt-3">Your order has been placed!</h2>
          <p class="text-muted">A confirmation has been sent to <strong><%= @order.email %></strong>.
            Keep your order number handy: <strong><%= @order.number %></strong></p>
        </div>

        <div class="card border-0 shadow-sm mb-4">
          <div class="card-body">
            <div class="row">
              <div class="col-sm-6 mb-3">
                <h4 class="text-uppercase" style="font-size:1.3rem;color:#999;">Order</h4>
                <p class="mb-0"><strong><%= @order.number %></strong></p>
                <p class="mb-0"><%= @order.created_at.strftime("%B %d, %Y at %H:%M") %></p>
                <p class="mb-0">Status:
                  <span class="badge badge-primary text-uppercase"><%= @order.status %></span>
                </p>
              </div>
              <div class="col-sm-6 mb-3">
                <h4 class="text-uppercase" style="font-size:1.3rem;color:#999;">Shipping to</h4>
                <p class="mb-0"><%= @order.customer_name %></p>
                <p class="mb-0"><%= @order.address %></p>
                <p class="mb-0"><%= [ @order.city, @order.postal_code, @order.country ].compact_blank.join(", ") %></p>
                <% if @order.phone.present? %><p class="mb-0"><%= @order.phone %></p><% end %>
              </div>
            </div>
          </div>
        </div>

        <table class="table table-summary">
          <thead>
            <tr><th>Product</th><th>Qty</th><th>Price</th><th>Total</th></tr>
          </thead>
          <tbody>
            <% @order.order_items.each do |item| %>
              <tr>
                <td>
                  <% if item.product %>
                    <%= link_to item.product_name, product_path(item.product) %>
                  <% else %>
                    <%= item.product_name %>
                  <% end %>
                </td>
                <td><%= item.quantity %></td>
                <td><%= number_to_currency item.unit_price %></td>
                <td><%= number_to_currency item.line_total %></td>
              </tr>
            <% end %>
            <tr class="summary-subtotal"><td colspan="3">Subtotal</td><td><%= number_to_currency @order.subtotal %></td></tr>
            <tr><td colspan="3">Shipping</td><td><%= @order.shipping.zero? ? "Free" : number_to_currency(@order.shipping) %></td></tr>
            <tr class="summary-total"><td colspan="3">Total</td><td><%= number_to_currency @order.total %></td></tr>
          </tbody>
        </table>

        <div class="text-center mt-4">
          <%= link_to "Continue Shopping", products_path, class: "btn btn-outline-primary-2" %>
        </div>
      </div>
    </div>
  </div>
</div>

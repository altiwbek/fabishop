<% content_for :title, "Checkout — Fabishop" %>

<div class="page-header text-center" style="background-image: url('/molla/assets/images/page-header-bg.jpg')">
  <div class="container">
    <h1 class="page-title">Checkout<span>Almost there</span></h1>
  </div>
</div>

<nav aria-label="breadcrumb" class="breadcrumb-nav">
  <div class="container">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><%= link_to "Home", root_path %></li>
      <li class="breadcrumb-item"><%= link_to "Cart", cart_path %></li>
      <li class="breadcrumb-item active">Checkout</li>
    </ol>
  </div>
</nav>

<div class="page-content">
  <div class="checkout">
    <div class="container">
      <%= form_with model: @order, url: checkout_path, method: :post, data: { turbo: false } do |f| %>
        <% if @order.errors.any? %>
          <div class="alert alert-danger">
            <%= @order.errors.full_messages.to_sentence %>
          </div>
        <% end %>

        <div class="row">
          <div class="col-lg-8">
            <h2 class="checkout-title">Billing Details</h2>

            <div class="row">
              <div class="col-sm-6">
                <label>First Name *</label>
                <%= f.text_field :first_name, class: "form-control", required: true %>
              </div>
              <div class="col-sm-6">
                <label>Last Name *</label>
                <%= f.text_field :last_name, class: "form-control", required: true %>
              </div>
            </div>

            <label>Email Address *</label>
            <%= f.email_field :email, class: "form-control", required: true %>

            <label>Phone</label>
            <%= f.telephone_field :phone, class: "form-control" %>

            <label>Street Address *</label>
            <%= f.text_field :address, class: "form-control", placeholder: "House number and street name", required: true %>

            <div class="row">
              <div class="col-sm-6">
                <label>Town / City *</label>
                <%= f.text_field :city, class: "form-control", required: true %>
              </div>
              <div class="col-sm-3">
                <label>Postcode</label>
                <%= f.text_field :postal_code, class: "form-control" %>
              </div>
              <div class="col-sm-3">
                <label>Country</label>
                <%= f.text_field :country, class: "form-control" %>
              </div>
            </div>

            <label>Order Notes (optional)</label>
            <%= f.text_area :notes, class: "form-control", cols: 30, rows: 4,
                  placeholder: "Notes about your order, e.g. special delivery instructions" %>
          </div>

          <aside class="col-lg-4">
            <div class="summary">
              <h3 class="summary-title">Your Order</h3>
              <% cart = current_cart %>
              <table class="table table-summary">
                <thead>
                  <tr><th>Product</th><th>Total</th></tr>
                </thead>
                <tbody>
                  <% cart.line_items.each do |product, qty| %>
                    <tr>
                      <td><%= link_to "#{product.name} × #{qty}", product_path(product) %></td>
                      <td><%= number_to_currency product.price * qty %></td>
                    </tr>
                  <% end %>
                  <% subtotal = cart.total_price %>
                  <% shipping = (subtotal >= Order::FREE_SHIPPING_THRESHOLD ? 0 : Order::SHIPPING_FLAT) %>
                  <tr class="summary-subtotal">
                    <td>Subtotal:</td>
                    <td><%= number_to_currency subtotal %></td>
                  </tr>
                  <tr>
                    <td>Shipping:</td>
                    <td><%= shipping.zero? ? "Free" : number_to_currency(shipping) %></td>
                  </tr>
                  <tr class="summary-total">
                    <td>Total:</td>
                    <td><%= number_to_currency subtotal + shipping %></td>
                  </tr>
                </tbody>
              </table>

              <div class="alert alert-info small">
                <i class="icon-info-circle"></i> This is a demo store — no payment is taken. Placing the order simulates a successful purchase.
              </div>

              <%= f.submit "Place Order", class: "btn btn-outline-primary-2 btn-order btn-block" %>
            </div>
          </aside>
        </div>
      <% end %>
    </div>
  </div>
</div>

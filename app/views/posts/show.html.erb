<% content_for :title, "#{@post.title} — Fabishop Blog" %>
<% content_for :description, post_excerpt(@post, length: 150) %>

<div class="page-header page-header-big text-center"
     style="background-image: url('<%= post_cover_url(@post) %>'); background-size: cover; background-position: center;">
  <div class="container" style="background: rgba(0,0,0,.35); padding: 4rem 2rem; border-radius: 4px;">
    <h1 class="page-title text-white"><%= @post.title %></h1>
  </div>
</div>

<nav aria-label="breadcrumb" class="breadcrumb-nav">
  <div class="container">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><%= link_to "Home", root_path %></li>
      <li class="breadcrumb-item"><%= link_to "Blog", posts_path %></li>
      <li class="breadcrumb-item active"><%= truncate(@post.title, length: 40) %></li>
    </ol>
  </div>
</nav>

<div class="page-content">
  <div class="container">
    <div class="row">
      <div class="col-lg-9">
        <article class="entry single-entry">
          <div class="entry-meta mb-3 text-muted">
            <% if @post.published_at %>
              <span><i class="icon-calendar mr-1"></i><%= @post.published_at.strftime("%b %d, %Y") %></span>
            <% end %>
            <% if @post.author %>
              <span class="ml-3"><i class="icon-user mr-1"></i><%= @post.author.display_name %></span>
            <% end %>
            <span class="ml-3"><i class="icon-clock mr-1"></i><%= @post.reading_minutes %> min read</span>
            <span class="ml-3"><i class="icon-eye mr-1"></i><%= @post.views_count %> views</span>
          </div>

          <% if @post.subtitle.present? %>
            <p class="lead"><%= @post.subtitle %></p>
          <% end %>

          <div class="entry-content trix-content">
            <%= @post.body %>
          </div>
        </article>
      </div>

      <aside class="col-lg-3">
        <div class="widget">
          <h3 class="widget-title">Recent Posts</h3>
          <ul class="widget-list">
            <% @recent_posts.each do |post| %>
              <li class="mb-2"><%= link_to post.title, post_path(post) %></li>
            <% end %>
          </ul>
        </div>
        <div class="widget">
          <h3 class="widget-title">Shop</h3>
          <%= link_to "Browse products", products_path, class: "btn btn-outline-primary-2 btn-block" %>
        </div>
      </aside>
    </div>
  </div>
</div>

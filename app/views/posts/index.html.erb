<% content_for :title, "Blog — MegaShop" %>

<div class="page-header text-center" style="background-image: url('/molla/assets/images/blog/blog-header-bg.jpg')">
  <div class="container">
    <h1 class="page-title">Our Blog<span>News, guides & stories</span></h1>
  </div>
</div>

<nav aria-label="breadcrumb" class="breadcrumb-nav">
  <div class="container">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><%= link_to "Home", root_path %></li>
      <li class="breadcrumb-item active">Blog</li>
    </ol>
  </div>
</nav>

<div class="page-content">
  <div class="container">
    <% if @posts.any? %>
      <div class="row">
        <% @posts.each do |post| %>
          <div class="col-sm-6 col-lg-4"><%= render "posts/card", post: post %></div>
        <% end %>
      </div>
      <%== pagy_bootstrap_nav(@pagy) if @pagy.pages > 1 %>
    <% else %>
      <div class="empty-state">
        <i class="icon-file-text"></i>
        <h3>No posts published yet</h3>
      </div>
    <% end %>
  </div>
</div>

<div class="flex items-center justify-between mb-6">
  <p class="text-gray-500 text-sm"><%= t("admin.users.count", count: @users.size) %></p>
  <% if current_user&.owner? %>
    <%= link_to new_admin_user_path, class: btn_primary do %><i class="las la-plus"></i> <%= t("admin.users.add") %><% end %>
  <% end %>
</div>

<div class="bg-white rounded-xl shadow-sm overflow-hidden">
  <table class="w-full text-sm">
    <thead class="text-left text-gray-500 border-b border-gray-100">
      <tr>
        <th class="px-4 py-3"><%= t("admin.users.cols.name") %></th>
        <th class="px-4 py-3"><%= t("admin.users.cols.email") %></th>
        <th class="px-4 py-3"><%= t("admin.users.cols.role") %></th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @users.each do |user| %>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-full bg-indigo-100 text-indigo-700 grid place-items-center text-xs font-semibold"><%= user.initials %></span>
              <span class="font-medium text-gray-900"><%= user.display_name %></span>
              <% if user == current_user %><span class="text-xs text-gray-400"><%= t("admin.common.you") %></span><% end %>
            </div>
          </td>
          <td class="px-4 py-3 text-gray-600"><%= user.email_address %></td>
          <td class="px-4 py-3"><%= status_badge t("admin.roles.#{user.role}"), color: (user.owner? ? :indigo : :gray) %></td>
          <td class="px-4 py-3 text-right space-x-2 whitespace-nowrap">
            <% if current_user&.owner? %>
              <%= link_to t("admin.actions.edit"), edit_admin_user_path(user), class: "text-indigo-600 hover:underline" %>
              <% unless user == current_user %>
                <%= button_to t("admin.actions.delete"), admin_user_path(user), method: :delete, class: "text-red-500 hover:underline inline",
                      form: { class: "inline", data: { turbo_confirm: t("admin.confirm.remove_named", name: user.display_name) } } %>
              <% end %>
            <% else %>
              <span class="text-gray-300"><%= t("admin.common.none") %></span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

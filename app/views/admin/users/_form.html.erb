<%= form_with model: [ :admin, @user ], html: { class: "max-w-lg" } do |f| %>
  <%= admin_form_errors(@user) %>
  <div class="bg-white rounded-xl shadow-sm p-6 space-y-4">
    <div>
      <%= f.label :name, class: label_classes %>
      <%= f.text_field :name, class: input_classes %>
    </div>
    <div>
      <%= f.label :email_address, t("admin.form.email"), class: label_classes %>
      <%= f.email_field :email_address, class: input_classes %>
    </div>
    <div>
      <%= f.label :role, class: label_classes %>
      <%= f.select :role, User.roles.keys.map { |r| [ t("admin.roles.#{r}"), r ] }, {}, class: input_classes %>
    </div>
    <div>
      <%= f.label :password, (@user.persisted? ? t("admin.form.new_password") : t("admin.form.password")), class: label_classes %>
      <%= f.password_field :password, class: input_classes, autocomplete: "new-password" %>
    </div>
    <div>
      <%= f.label :password_confirmation, t("admin.form.confirm_password"), class: label_classes %>
      <%= f.password_field :password_confirmation, class: input_classes, autocomplete: "new-password" %>
    </div>
  </div>
  <div class="mt-6 flex gap-3">
    <%= f.submit(@user.persisted? ? t("admin.actions.save") : t("admin.form.create_user"), class: btn_primary) %>
    <%= link_to t("admin.actions.cancel"), admin_users_path, class: btn_secondary %>
  </div>
<% end %>

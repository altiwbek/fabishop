<%= form_with model: [ :admin, @user ], html: { class: "max-w-lg" } do |f| %>
  <%= admin_form_errors(@user) %>
  <div class="bg-white rounded-xl shadow-sm p-6 space-y-4">
    <div>
      <%= f.label :name, class: label_classes %>
      <%= f.text_field :name, class: input_classes %>
    </div>
    <div>
      <%= f.label :email_address, "Email", class: label_classes %>
      <%= f.email_field :email_address, class: input_classes %>
    </div>
    <div>
      <%= f.label :role, class: label_classes %>
      <%= f.select :role, User.roles.keys.map { |r| [ r.capitalize, r ] }, {}, class: input_classes %>
    </div>
    <div>
      <%= f.label :password, (@user.persisted? ? "New password (leave blank to keep)" : "Password"), class: label_classes %>
      <%= f.password_field :password, class: input_classes, autocomplete: "new-password" %>
    </div>
    <div>
      <%= f.label :password_confirmation, "Confirm password", class: label_classes %>
      <%= f.password_field :password_confirmation, class: input_classes, autocomplete: "new-password" %>
    </div>
  </div>
  <div class="mt-6 flex gap-3">
    <%= f.submit(@user.persisted? ? "Save" : "Create user", class: btn_primary) %>
    <%= link_to "Cancel", admin_users_path, class: btn_secondary %>
  </div>
<% end %>

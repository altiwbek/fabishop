<div class="flex items-center gap-2 mb-6 flex-wrap">
  <% active = params[:status].blank? %>
  <%= link_to "All (#{@status_counts.values.sum})", admin_orders_path,
        class: "px-3 py-1.5 rounded-lg text-sm font-medium #{active ? 'bg-indigo-600 text-white' : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50'}" %>
  <% Order.statuses.keys.each do |status| %>
    <% is_active = params[:status] == status %>
    <%= link_to admin_orders_path(status: status),
          class: "px-3 py-1.5 rounded-lg text-sm font-medium capitalize #{is_active ? 'bg-indigo-600 text-white' : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50'}" do %>
      <%= status %> <span class="text-xs opacity-70">(<%= @status_counts[status] || 0 %>)</span>
    <% end %>
  <% end %>
</div>

<div class="bg-white rounded-xl shadow-sm overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="text-left text-gray-500 border-b border-gray-100">
        <tr>
          <th class="px-4 py-3">Order</th>
          <th class="px-4 py-3">Customer</th>
          <th class="px-4 py-3">Date</th>
          <th class="px-4 py-3">Items</th>
          <th class="px-4 py-3">Total</th>
          <th class="px-4 py-3">Status</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @orders.each do |order| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 font-medium text-gray-900"><%= link_to order.number, admin_order_path(order), class: "hover:text-indigo-600" %></td>
            <td class="px-4 py-3 text-gray-600">
              <%= order.customer_name %>
              <div class="text-xs text-gray-400"><%= order.email %></div>
            </td>
            <td class="px-4 py-3 text-gray-500"><%= order.created_at.strftime("%b %d, %Y") %></td>
            <td class="px-4 py-3"><%= order.item_count %></td>
            <td class="px-4 py-3 font-semibold text-gray-900"><%= number_to_currency order.total %></td>
            <td class="px-4 py-3"><%= status_badge order.status.capitalize, color: order.status_color %></td>
            <td class="px-4 py-3 text-right">
              <%= link_to "View", admin_order_path(order), class: "text-indigo-600 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @orders.empty? %><div class="p-10 text-center text-gray-400">No orders yet.</div><% end %>
</div>
<div class="mt-4"><%== pagy_tailwind_nav(@pagy) if @pagy.pages > 1 %></div>

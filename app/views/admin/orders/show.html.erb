<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
  <%= link_to admin_orders_path, class: "text-sm text-gray-500 hover:text-indigo-600" do %>
    <i class="las la-arrow-left"></i> <%= t("admin.form.back") %>
  <% end %>
  <div class="flex items-center gap-3">
    <%= status_badge t("admin.orders.statuses.#{@order.status}"), color: @order.status_color %>
    <%= form_with url: admin_order_path(@order), method: :patch, class: "flex items-center gap-2" do %>
      <%= select_tag "order[status]", options_for_select(Order.statuses.keys.map { |s| [ t("admin.orders.statuses.#{s}"), s ] }, @order.status),
            class: "#{input_classes} w-auto py-1.5" %>
      <button class="<%= btn_primary %>"><%= t("admin.show.update") %></button>
    <% end %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 bg-white rounded-xl shadow-sm p-6">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h2 class="text-xl font-bold text-gray-900"><%= @order.number %></h2>
        <p class="text-sm text-gray-400"><%= @order.created_at.strftime("%B %d, %Y at %H:%M") %></p>
      </div>
    </div>
    <table class="w-full text-sm">
      <thead class="text-left text-gray-500 border-b border-gray-100">
        <tr><th class="py-2"><%= t("admin.products.cols.product") %></th><th class="py-2"><%= t("admin.products.cols.price") %></th><th class="py-2"><%= t("admin.show.qty") %></th><th class="py-2 text-right"><%= t("admin.orders.cols.total") %></th></tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @order.order_items.each do |item| %>
          <tr>
            <td class="py-3">
              <% if item.product %>
                <%= link_to item.product_name, admin_product_path(item.product), class: "text-gray-900 hover:text-indigo-600 font-medium" %>
              <% else %>
                <span class="text-gray-900 font-medium"><%= item.product_name %></span>
              <% end %>
              <% if item.sku.present? %><div class="text-xs text-gray-400"><%= item.sku %></div><% end %>
            </td>
            <td class="py-3 text-gray-600"><%= number_to_currency item.unit_price %></td>
            <td class="py-3 text-gray-600"><%= item.quantity %></td>
            <td class="py-3 text-right font-medium"><%= number_to_currency item.line_total %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot class="text-sm">
        <tr><td colspan="3" class="py-1 text-right text-gray-500"><%= t("admin.show.subtotal") %></td><td class="py-1 text-right"><%= number_to_currency @order.subtotal %></td></tr>
        <tr><td colspan="3" class="py-1 text-right text-gray-500"><%= t("admin.show.shipping") %></td><td class="py-1 text-right"><%= @order.shipping.zero? ? t("admin.show.free") : number_to_currency(@order.shipping) %></td></tr>
        <tr class="font-bold text-gray-900"><td colspan="3" class="py-2 text-right"><%= t("admin.orders.cols.total") %></td><td class="py-2 text-right"><%= number_to_currency @order.total %></td></tr>
      </tfoot>
    </table>
  </div>

  <div class="space-y-6">
    <div class="bg-white rounded-xl shadow-sm p-6 text-sm">
      <h3 class="font-semibold text-gray-900 mb-3"><%= t("admin.orders.cols.customer") %></h3>
      <p class="font-medium"><%= @order.customer_name %></p>
      <p class="text-gray-600"><%= mail_to @order.email, @order.email, class: "text-indigo-600 hover:underline" %></p>
      <% if @order.phone.present? %><p class="text-gray-600"><%= @order.phone %></p><% end %>
    </div>
    <div class="bg-white rounded-xl shadow-sm p-6 text-sm">
      <h3 class="font-semibold text-gray-900 mb-3"><%= t("admin.show.shipping_address") %></h3>
      <p class="text-gray-600"><%= @order.address %></p>
      <p class="text-gray-600"><%= [ @order.city, @order.postal_code ].compact_blank.join(", ") %></p>
      <p class="text-gray-600"><%= @order.country %></p>
    </div>
    <% if @order.notes.present? %>
      <div class="bg-white rounded-xl shadow-sm p-6 text-sm">
        <h3 class="font-semibold text-gray-900 mb-3"><%= t("admin.show.order_notes") %></h3>
        <p class="text-gray-600"><%= @order.notes %></p>
      </div>
    <% end %>
  </div>
</div>

<div class="flex items-center justify-between mb-6">
  <%= link_to "← Back to collections", admin_collections_path, class: "text-sm text-gray-500 hover:text-indigo-600" %>
  <%= link_to edit_admin_collection_path(@collection), class: btn_secondary do %><i class="las la-edit"></i> Edit details<% end %>
</div>

<div class="mb-6">
  <h2 class="text-2xl font-bold text-gray-900"><%= @collection.name %></h2>
  <p class="text-gray-500"><%= @collection.subtitle %></p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 bg-white rounded-xl shadow-sm p-6">
    <h3 class="font-semibold text-gray-900 mb-4">Products in this collection (<%= @in_collection.size %>)</h3>
    <% if @in_collection.any? %>
      <div class="divide-y divide-gray-100">
        <% @in_collection.each do |product| %>
          <div class="flex items-center gap-3 py-3">
            <img src="<%= product_image_url(product) %>" class="w-10 h-10 rounded object-cover bg-gray-100">
            <%= link_to product.name, admin_product_path(product), class: "flex-1 text-sm font-medium text-gray-900 hover:text-indigo-600" %>
            <span class="text-sm text-gray-500"><%= number_to_currency product.price %></span>
            <%= button_to admin_collection_collection_product_path(@collection, product.id), method: :delete,
                  class: "text-red-500 hover:text-red-700", title: "Remove",
                  form: { class: "inline" } do %>
              <i class="las la-times-circle text-lg"></i>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-400">No products yet. Add some from the panel on the right.</p>
    <% end %>
  </div>

  <div class="bg-white rounded-xl shadow-sm p-6">
    <h3 class="font-semibold text-gray-900 mb-4">Add a product</h3>
    <%= form_with url: admin_collection_collection_products_path(@collection), method: :post, class: "space-y-3" do %>
      <%= select_tag :product_id,
            options_from_collection_for_select(@available, :id, :name),
            class: input_classes, prompt: "Choose a product…" %>
      <button class="<%= btn_primary %> w-full justify-center"><i class="las la-plus"></i> Add to collection</button>
    <% end %>
    <p class="text-xs text-gray-400 mt-3"><%= @available.size %> products available to add.</p>
  </div>
</div>

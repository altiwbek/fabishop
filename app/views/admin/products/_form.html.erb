<%= form_with model: [ :admin, @product ], html: { class: "space-y-6" } do |f| %>
  <%= admin_form_errors(@product) %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main -->
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white rounded-xl shadow-sm p-6 space-y-4">
        <%= render "admin/shared/translated_field", form: f, attribute: :name, label: t("admin.form.name") %>
        <%= render "admin/shared/translated_field", form: f, attribute: :subtitle, label: t("admin.form.short_subtitle") %>
        <div class="space-y-4">
          <% available_locales.each do |loc| %>
            <div>
              <%= f.label :"description_#{loc}", "#{t("admin.form.description")} (#{locale_short(loc)})", class: label_classes %>
              <div class="trix-wrapper border border-gray-300 rounded-lg overflow-hidden">
                <%= f.rich_text_area :"description_#{loc}" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-sm p-6">
        <h3 class="font-semibold text-gray-900 mb-4"><%= t("admin.form.images") %></h3>
        <% if @product.persisted? && @product.images.attached? %>
          <div class="grid grid-cols-3 sm:grid-cols-5 gap-3 mb-4">
            <% @product.images.each do |img| %>
              <div id="product_image_<%= img.id %>" class="relative group">
                <%= image_tag url_for(img), class: "w-full h-24 object-cover rounded-lg border border-gray-200" %>

                <%= link_to admin_product_product_image_path(@product, img.id), data: { turbo_method: :delete },
                      class: "absolute -top-2 -right-2 bg-red-600 text-white w-6 h-6 rounded-full grid place-items-center text-xs opacity-0 group-hover:opacity-100 transition",
                      title: t("admin.form.remove") do %>
                  <i class="las la-times"></i>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
        <%= f.file_field :images, multiple: true, accept: "image/*",
              class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100" %>
        <p class="text-xs text-gray-400 mt-2"><%= t("admin.form.images_hint") %></p>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <div class="bg-white rounded-xl shadow-sm p-6 space-y-4">
        <h3 class="font-semibold text-gray-900"><%= t("admin.form.organization") %></h3>
        <div>
          <%= f.label :category_id, t("admin.form.category"), class: label_classes %>
          <%= f.collection_select :category_id, Category.ordered, :id, :name, { prompt: t("admin.form.select_category") }, class: input_classes %>
        </div>
        <div>
          <%= f.label :brand_id, t("admin.form.brand_optional"), class: label_classes %>
          <%= f.collection_select :brand_id, Brand.ordered, :id, :name, { include_blank: t("admin.form.no_brand") }, class: input_classes %>
        </div>
        <div>
          <%= f.label :collection_ids, t("admin.form.collections"), class: label_classes %>
          <div class="space-y-1.5 max-h-40 overflow-y-auto border border-gray-200 rounded-lg p-3">
            <% Collection.ordered.each do |collection| %>
              <label class="flex items-center gap-2 text-sm text-gray-700">
                <%= check_box_tag "product[collection_ids][]", collection.id,
                      @product.collection_ids.include?(collection.id),
                      id: "collection_#{collection.id}", class: "rounded border-gray-300 text-indigo-600" %>
                <%= collection.name %>
              </label>
            <% end %>
            <%= hidden_field_tag "product[collection_ids][]", "" %>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-sm p-6 space-y-4">
        <h3 class="font-semibold text-gray-900"><%= t("admin.form.pricing_stock") %></h3>
        <div>
          <%= f.label :price, class: label_classes %>
          <%= f.number_field :price, step: 0.01, class: input_classes %>
        </div>
        <div>
          <%= f.label :compare_at_price, t("admin.form.compare_at_price"), class: label_classes %>
          <%= f.number_field :compare_at_price, step: 0.01, class: input_classes, placeholder: t("admin.form.original_price") %>
        </div>
        <div>
          <%= f.label :stock, class: label_classes %>
          <%= f.number_field :stock, class: input_classes %>
        </div>
        <div>
          <%= f.label :sku, t("admin.form.sku"), class: label_classes %>
          <%= f.text_field :sku, class: input_classes %>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-sm p-6 space-y-3">
        <h3 class="font-semibold text-gray-900"><%= t("admin.form.visibility") %></h3>
        <% [[:published, t("admin.form.published_visible")], [:featured, t("admin.form.featured")], [:new_arrival, t("admin.form.new_arrival")], [:on_sale, t("admin.form.on_sale")]].each do |attr, label| %>
          <label class="flex items-center gap-2 text-sm text-gray-700">
            <%= f.check_box attr, class: "rounded border-gray-300 text-indigo-600" %>
            <%= label %>
          </label>
        <% end %>
      </div>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit(@product.persisted? ? t("admin.actions.save_changes") : t("admin.form.create_product"), class: btn_primary) %>
    <%= link_to t("admin.actions.cancel"), (@product.persisted? ? admin_product_path(@product) : admin_products_path), class: btn_secondary %>
  </div>
<% end %>

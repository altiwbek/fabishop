<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
  <%= link_to admin_products_path, class: "text-sm text-gray-500 hover:text-indigo-600" do %>
    <i class="las la-arrow-left"></i> <%= t("admin.form.back") %>
  <% end %>
  <div class="flex items-center gap-3">
    <%= render "admin/products/status", product: @product %>
    <%= link_to product_path(@product), target: "_blank", class: btn_secondary do %>
      <i class="las la-external-link-alt"></i> <%= t("admin.show.view_on_store") %>
    <% end %>
    <%= link_to edit_admin_product_path(@product), class: btn_primary do %>
      <i class="las la-edit"></i> <%= t("admin.actions.edit") %>
    <% end %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 space-y-6">
    <div class="bg-white rounded-xl shadow-sm p-6">
      <div class="flex items-start gap-5">
        <img src="<%= product_image_url(@product) %>" class="w-32 h-32 rounded-lg object-cover bg-gray-100 shrink-0">
        <div>
          <h2 class="text-xl font-bold text-gray-900"><%= @product.name %></h2>
          <p class="text-gray-500"><%= @product.subtitle %></p>
          <div class="mt-3 flex items-center gap-3">
            <span class="text-2xl font-bold text-gray-900"><%= number_to_currency @product.price %></span>
            <% if @product.on_sale? %>
              <span class="text-gray-400 line-through"><%= number_to_currency @product.compare_at_price %></span>
              <%= status_badge "-#{@product.discount_percent}%", color: :red %>
            <% end %>
          </div>
        </div>
      </div>

      <% if @product.images.attached? && @product.images.size > 1 %>
        <div class="grid grid-cols-6 gap-2 mt-5">
          <% @product.images.each do |img| %>
            <%= image_tag url_for(img), class: "w-full h-16 object-cover rounded border border-gray-200" %>
          <% end %>
        </div>
      <% end %>

      <% if @product.description.to_plain_text.present? %>
        <div class="prose prose-sm max-w-none mt-6 text-gray-700 trix-content">
          <%= @product.description %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="space-y-6">
    <div class="bg-white rounded-xl shadow-sm p-6 space-y-3 text-sm">
      <h3 class="font-semibold text-gray-900 mb-2"><%= t("admin.show.details") %></h3>
      <div class="flex justify-between"><span class="text-gray-500"><%= t("admin.form.category") %></span><span class="font-medium"><%= @product.category.name %></span></div>
      <div class="flex justify-between"><span class="text-gray-500"><%= t("admin.show.brand") %></span><span class="font-medium"><%= @product.brand&.name || t("admin.common.none") %></span></div>
      <div class="flex justify-between"><span class="text-gray-500"><%= t("admin.form.sku") %></span><span class="font-medium"><%= @product.sku.presence || t("admin.common.none") %></span></div>
      <div class="flex justify-between"><span class="text-gray-500"><%= t("admin.form.stock") %></span><span class="font-medium"><%= @product.stock %></span></div>
      <div class="flex justify-between"><span class="text-gray-500"><%= t("admin.show.views") %></span><span class="font-medium"><%= @product.views_count %></span></div>
      <div class="flex justify-between items-center"><span class="text-gray-500"><%= t("admin.show.rating") %></span>
        <span class="font-medium flex items-center gap-1 text-yellow-500">
          <i class="las la-star"></i><%= @product.rating %> <span class="text-gray-400">(<%= @product.reviews_count %>)</span>
        </span>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm p-6">
      <h3 class="font-semibold text-gray-900 mb-3"><%= t("admin.form.collections") %></h3>
      <% if @product.collections.any? %>
        <div class="flex flex-wrap gap-2">
          <% @product.collections.each do |c| %>
            <%= link_to c.name, admin_collection_path(c), class: "px-2.5 py-1 rounded-full bg-indigo-50 text-indigo-700 text-xs hover:bg-indigo-100" %>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-gray-400"><%= t("admin.show.not_in_collection") %></p>
      <% end %>
    </div>

    <div class="bg-white rounded-xl shadow-sm p-6">
      <div class="flex flex-wrap gap-2">
        <% if @product.featured? %><%= status_badge(t("admin.common.featured"), color: :indigo) %><% end %>
        <% if @product.new_arrival? %><%= status_badge(t("admin.show.new"), color: :green) %><% end %>
        <% if @product.on_sale? %><%= status_badge(t("admin.show.on_sale"), color: :red) %><% end %>
        <% unless @product.featured? || @product.new_arrival? || @product.on_sale? %>
          <span class="text-sm text-gray-400"><%= t("admin.show.no_flags") %></span>
        <% end %>
      </div>
    </div>
  </div>
</div>

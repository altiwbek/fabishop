<% flash.each do |type, message| %>
  <% next if message.blank? %>
  <% styles = {
       "notice"  => "bg-green-50 text-green-800 border-green-200",
       "success" => "bg-green-50 text-green-800 border-green-200",
       "alert"   => "bg-red-50 text-red-800 border-red-200",
       "error"   => "bg-red-50 text-red-800 border-red-200"
     }[type.to_s] || "bg-blue-50 text-blue-800 border-blue-200" %>
  <div class="mb-4 flex items-start gap-3 rounded-lg border px-4 py-3 text-sm <%= styles %>"
       data-controller="toast" data-toast-delay-value="5000">
    <i class="las la-info-circle text-lg"></i>
    <span class="flex-1"><%= message %></span>
    <button data-action="toast#dismiss" class="text-current/60 hover:text-current">&times;</button>
  </div>
<% end %>

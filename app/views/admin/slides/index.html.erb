<div class="flex items-center justify-between mb-6">
  <p class="text-gray-500 text-sm"><%= t("admin.slides.count", count: @slides.size) %> · <%= t("admin.slides.hint") %></p>
  <%= link_to new_admin_slide_path, class: btn_primary do %><i class="las la-plus"></i> <%= t("admin.slides.new") %><% end %>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
  <% @slides.each do |slide| %>
    <div class="bg-white rounded-xl shadow-sm overflow-hidden flex">
      <div class="w-40 shrink-0 bg-gray-100">
        <% if slide.image.attached? %>
          <%= image_tag url_for(slide.image), class: "w-full h-full object-cover" %>
        <% else %>
          <div class="w-full h-full grid place-items-center text-gray-300"><i class="las la-image text-3xl"></i></div>
        <% end %>
      </div>
      <div class="p-4 flex-1 min-w-0">
        <div class="flex items-start justify-between gap-2">
          <div class="min-w-0">
            <% if slide.subtitle.present? %><p class="text-xs text-indigo-600 font-medium"><%= slide.subtitle %></p><% end %>
            <h3 class="font-semibold text-gray-900 truncate"><%= slide.title.tr("|", " ") %></h3>
          </div>
          <div class="flex flex-col items-end gap-1 shrink-0">
            <%= boolean_badge slide.active, true_text: t("admin.common.active"), false_text: t("admin.common.hidden") %>
            <span class="text-xs text-gray-400">#<%= slide.position %></span>
          </div>
        </div>
        <% if slide.button_label.present? %>
          <p class="text-xs text-gray-400 mt-2"><i class="las la-mouse-pointer"></i> <%= slide.button_label %> → <%= slide.button_url.presence || t("admin.common.none") %></p>
        <% end %>
        <div class="mt-4 flex gap-2">
          <%= link_to t("admin.actions.edit"), edit_admin_slide_path(slide), class: "#{btn_secondary} text-xs py-1.5 px-3" %>
          <%= button_to t("admin.actions.delete"), admin_slide_path(slide), method: :delete, class: "#{btn_secondary} text-xs py-1.5 px-3 text-red-600",
                form: { data: { turbo_confirm: t("admin.confirm.delete_slide") } } %>
        </div>
      </div>
    </div>
  <% end %>
</div>
<% if @slides.empty? %><div class="p-10 text-center text-gray-400 bg-white rounded-xl mt-4"><%= t("admin.slides.empty") %></div><% end %>

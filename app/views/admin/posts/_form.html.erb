<%= form_with model: [ :admin, @post ], html: { class: "space-y-6" } do |f| %>
  <%= admin_form_errors(@post) %>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 bg-white rounded-xl shadow-sm p-6 space-y-4">
      <%= render "admin/shared/translated_field", form: f, attribute: :title, label: t("admin.form.title") %>
      <%= render "admin/shared/translated_field", form: f, attribute: :subtitle, label: t("admin.form.subtitle") %>
      <%= render "admin/shared/translated_field", form: f, attribute: :excerpt, label: t("admin.form.excerpt_preview"), as: :text_area, rows: 2 %>
      <div>
        <%= f.label :body, class: label_classes %>
        <div class="border border-gray-300 rounded-lg overflow-hidden">
          <%= f.rich_text_area :body %>
        </div>
      </div>
    </div>

    <div class="space-y-6">
      <div class="bg-white rounded-xl shadow-sm p-6 space-y-4">
        <label class="flex items-center gap-2 text-sm text-gray-700">
          <%= f.check_box :published, class: "rounded border-gray-300 text-indigo-600" %> <%= t("admin.form.published") %>
        </label>
        <div>
          <%= f.label :author_id, t("admin.form.author"), class: label_classes %>
          <%= f.collection_select :author_id, User.order(:name), :id, :display_name, { include_blank: "—" }, class: input_classes %>
        </div>
      </div>
      <div class="bg-white rounded-xl shadow-sm p-6">
        <%= f.label :cover, t("admin.form.cover_image"), class: label_classes %>
        <% if @post.cover.attached? %><%= image_tag url_for(@post.cover), class: "w-full h-32 object-cover rounded mb-2" %><% end %>
        <%= f.file_field :cover, accept: "image/*", class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-indigo-50 file:text-indigo-700" %>
      </div>
    </div>
  </div>
  <div class="flex gap-3">
    <%= f.submit(@post.persisted? ? t("admin.form.save_post") : t("admin.form.create_post"), class: btn_primary) %>
    <%= link_to t("admin.actions.cancel"), admin_posts_path, class: btn_secondary %>
  </div>
<% end %>

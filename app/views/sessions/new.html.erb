<h2 class="text-xl font-semibold text-gray-900 mb-1">Welcome back</h2>
<p class="text-sm text-gray-500 mb-6">Sign in to manage your store.</p>

<%= form_with url: session_path, method: :post, class: "space-y-4" do |f| %>
  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1">Email address</label>
    <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
          value: params[:email_address],
          class: "w-full rounded-lg border border-gray-300 px-3 py-2.5 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none" %>
  </div>

  <div>
    <div class="flex items-center justify-between mb-1">
      <label class="block text-sm font-medium text-gray-700">Password</label>
      <%= link_to "Forgot?", new_password_path, class: "text-xs text-indigo-600 hover:underline" %>
    </div>
    <%= f.password_field :password, required: true, autocomplete: "current-password", maxlength: 72,
          class: "w-full rounded-lg border border-gray-300 px-3 py-2.5 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none" %>
  </div>

  <%= f.submit "Sign in", class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2.5 rounded-lg transition cursor-pointer" %>
<% end %>

<div class="mt-6 text-center">
  <%= link_to "← Back to store", root_path, class: "text-sm text-gray-400 hover:text-gray-600" %>
</div>

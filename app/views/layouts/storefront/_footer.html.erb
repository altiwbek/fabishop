<footer class="footer">
  <div class="footer-middle">
    <div class="container">
      <div class="row">
        <div class="col-sm-6 col-lg-3">
          <div class="widget widget-about">
            <a href="<%= root_path %>" class="logo mb-3 d-inline-block">
              <span class="logo-text" style="color:#fff;">Fabishop<span>.</span></span>
            </a>
            <p><%= t("footer.about") %></p>
            <div class="widget-call">
              <i class="icon-phone"></i>
              <%= t("footer.questions") %>
              <a href="tel:#">+996 (700) 123-456</a>
            </div>
          </div>
        </div>

        <div class="col-sm-6 col-lg-3">
          <div class="widget">
            <h4 class="widget-title"><%= t("footer.shop") %></h4>
            <ul class="widget-list">
              <li><%= link_to t("footer.all_products"), products_path %></li>
              <% nav_collections.first(4).each do |collection| %>
                <li><%= link_to collection.name, collection_path(collection) %></li>
              <% end %>
            </ul>
          </div>
        </div>

        <div class="col-sm-6 col-lg-3">
          <div class="widget">
            <h4 class="widget-title"><%= t("footer.categories") %></h4>
            <ul class="widget-list">
              <% nav_categories.first(6).each do |category| %>
                <li><%= link_to category.name, category_path(category) %></li>
              <% end %>
            </ul>
          </div>
        </div>

        <div class="col-sm-6 col-lg-3">
          <div class="widget">
            <h4 class="widget-title"><%= t("footer.my_account") %></h4>
            <ul class="widget-list">
              <li><%= link_to t("footer.view_cart"), cart_path %></li>
              <li><%= link_to t("footer.my_wishlist"), wishlist_path %></li>
              <li><%= link_to t("footer.track_order"), track_path %></li>
              <li><%= link_to t("footer.blog"), posts_path %></li>
              <li><%= link_to t("footer.staff_sign_in"), new_session_path %></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p class="footer-copyright"><%= t("footer.copyright", year: Date.current.year) %></p>
      <ul class="footer-menu">
        <li><a href="#"><%= t("footer.terms") %></a></li>
        <li><a href="#"><%= t("footer.privacy") %></a></li>
      </ul>
    </div>
  </div>
</footer>

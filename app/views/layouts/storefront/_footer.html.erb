<footer class="footer">
  <div class="footer-middle">
    <div class="container">
      <div class="row">
        <div class="col-sm-6 col-lg-3">
          <div class="widget widget-about">
            <a href="<%= root_path %>" class="logo mb-3 d-inline-block">
              <span class="logo-text" style="color:#fff;">MegaShop<span>.</span></span>
            </a>
            <p>Your one-stop shop for cameras, smartwatches, smartphones and lifestyle gear — curated collections and honest reviews.</p>
            <div class="widget-call">
              <i class="icon-phone"></i>
              Got Questions? Call us 24/7
              <a href="tel:#">+996 (700) 123-456</a>
            </div>
          </div>
        </div>

        <div class="col-sm-6 col-lg-3">
          <div class="widget">
            <h4 class="widget-title">Shop</h4>
            <ul class="widget-list">
              <li><%= link_to "All products", products_path %></li>
              <% nav_collections.first(4).each do |collection| %>
                <li><%= link_to collection.name, collection_path(collection) %></li>
              <% end %>
            </ul>
          </div>
        </div>

        <div class="col-sm-6 col-lg-3">
          <div class="widget">
            <h4 class="widget-title">Categories</h4>
            <ul class="widget-list">
              <% nav_categories.first(6).each do |category| %>
                <li><%= link_to category.name, category_path(category) %></li>
              <% end %>
            </ul>
          </div>
        </div>

        <div class="col-sm-6 col-lg-3">
          <div class="widget">
            <h4 class="widget-title">My Account</h4>
            <ul class="widget-list">
              <li><%= link_to "View Cart", cart_path %></li>
              <li><%= link_to "My Wishlist", wishlist_path %></li>
              <li><%= link_to "Track My Order", track_path %></li>
              <li><%= link_to "Blog", posts_path %></li>
              <li><%= link_to "Staff sign in", new_session_path %></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p class="footer-copyright">Copyright © <%= Date.current.year %> MegaShop Store. All Rights Reserved.</p>
      <ul class="footer-menu">
        <li><a href="#">Terms Of Use</a></li>
        <li><a href="#">Privacy Policy</a></li>
      </ul>
    </div>
  </div>
</footer>

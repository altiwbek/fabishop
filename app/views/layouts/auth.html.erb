<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= content_for(:title).presence || "Sign in · Fabishop Admin" %></title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  <link rel="stylesheet" href="/molla/assets/vendor/line-awesome/line-awesome/line-awesome/css/line-awesome.min.css?v=1.3.0">
</head>
<body class="h-full bg-gradient-to-br from-gray-900 via-gray-800 to-indigo-900">
  <div class="min-h-full flex items-center justify-center p-4">
    <div class="w-full max-w-md">
      <div class="text-center mb-6">
        <a href="<%= root_path %>" class="text-3xl font-bold text-white">Fabishop<span class="text-indigo-400">.</span></a>
        <p class="text-gray-400 mt-1 text-sm">Store management console</p>
      </div>

      <div class="bg-white rounded-2xl shadow-xl p-8">
        <% if flash.any? %>
          <% flash.each do |type, message| %>
            <% next if message.blank? %>
            <div class="mb-4 rounded-lg px-4 py-3 text-sm <%= %w[alert error].include?(type.to_s) ? 'bg-red-50 text-red-700' : 'bg-green-50 text-green-700' %>">
              <%= message %>
            </div>
          <% end %>
        <% end %>
        <%= yield %>
      </div>

      <p class="text-center text-gray-500 text-xs mt-6">© <%= Date.current.year %> Fabishop Store</p>
    </div>
  </div>
</body>
</html>
